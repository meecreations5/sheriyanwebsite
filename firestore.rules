rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  // The public website can read published CMS content. All admin changes go
  // through authorised Next.js server routes using Google Cloud IAM.
  match /cms_pages/{id} { allow read: if true; allow write: if false; }
  match /cms_products/{id} { allow read: if true; allow write: if false; }
  match /cms_collections/{id} { allow read: if true; allow write: if false; }
  match /cms_categories/{id} { allow read: if true; allow write: if false; }
  match /cms_curated_collections/{id} { allow read: if true; allow write: if false; }
  match /cms_forms/{id} { allow read: if true; allow write: if false; }
  match /cms_settings/{id} { allow read: if true; allow write: if false; }
  match /cms_media/{id} { allow read: if true; allow write: if false; }

  // Password hashes, roles, sessions, login attempts, customer enquiries,
  // and internal revision/audit data must NEVER be client-readable.
  match /cms_users/{id} { allow read,write: if false; }
  match /cms_requests/{id} { allow read,write: if false; }
  match /cms_revisions/{id} { allow read,write: if false; }
  match /cms_login_attempts/{id} { allow read,write: if false; }
  match /cms_internal/{id} { allow read,write: if false; }
  match /cms_pending_uploads/{id} { allow read,write: if false; }
  match /{document=**} { allow read,write: if false; }
 }
}
