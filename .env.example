# SERVER ONLY — required to access Firestore privately from Next.js.
# If your hosting already supplies Google Cloud service identity (ADC), omit.
# Otherwise use a private server-side Google Cloud credential in Vercel.
# NEVER upload this credential to GitHub or share it with visitors.
CMS_GOOGLE_CREDENTIALS_JSON=

# Signed HTTP-only admin session secret. 32+ random characters; required if
# your Google Cloud runtime supplies ADC instead of a JSON private key.
CMS_SESSION_SECRET=

# First Super Admin is created directly in Firestore cms_users.
# Generate its one-way password hash with:
#   node scripts/generate-super-admin-record.mjs shanerynadmin
# Do NOT put an admin username or password in environment variables.

# Optional canonical website URL.
# NEXT_PUBLIC_SITE_URL=https://your-domain.example
