rules_version = '2';
service firebase.storage {
 match /b/{bucket}/o {
  // Public campaign/product assets are readable. Browser SDK writes are
  // disabled; authenticated Next.js APIs use the server Storage SDK and
  // short-lived signed upload URLs instead (Google Cloud Storage server client).
  match /media/{allPaths=**} { allow read: if true; allow write: if false; }
  match /{allPaths=**} { allow read,write: if false; }
 }
}
